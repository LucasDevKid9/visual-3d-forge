# 统一换行，避免 Windows 贡献者的 CRLF 触发校验器
* text=auto eol=lf

# vendor 是第三方构建产物：不计入语言统计，也不在 diff 里展开
assets/vendor/** linguist-vendored
assets/vendor/** -diff
assets/vendor/** linguist-generated

# 离线 IIFE 运行时与 addon 都是第三方构建产物：同 vendor 处理
assets/three/** linguist-vendored
assets/three/** -diff
assets/three/** linguist-generated

# 二进制资产
*.gif binary
*.png binary
*.jpg binary

# HTML 示例按源码统计（默认会被当成文档排除）
examples/**/*.html linguist-detectable=true
assets/scaffold/**/*.html linguist-detectable=true
playground/*.html linguist-detectable=true

# MHTML 存档是二进制容器：RFC 2557 要求分段头用 CRLF，
# text=auto 会把 CRLF 转成 LF，破坏分段边界与 binary 载荷。
tests/fixtures/*.mht -text -diff
*.mht -text
*.mhtml -text
